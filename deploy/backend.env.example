# Copia este fichero a backend.env y rellénalo (NO se sube a git).
# Lo carga el contenedor api (sección env_file del compose).

# --- Obligatorio ---------------------------------------------------------
# Generación nueva:  openssl rand -base64 48
SECRET_KEY=
# CORS: orígenes desde los que la web/app habla con la API.
CORS_ORIGINS=https://assetsmanager.l20j45.us,http://localhost:5173,http://tauri.localhost,https://tauri.localhost

