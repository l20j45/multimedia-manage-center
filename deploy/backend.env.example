# Copia este fichero a backend.env y rellénalo (NO se sube a git).
# Lo carga el contenedor api (sección env_file del compose).

# --- Obligatorio ---------------------------------------------------------
# Generación nueva:  openssl rand -base64 48
SECRET_KEY=
# CORS: orígenes que hablan con la API desde un NAVEGADOR.
# Las IPs de tus clientes/dispositivos NO van aquí (CORS es por origen de página).
CORS_ORIGINS=https://assetsmanager.l20j45.us,http://localhost:5173,http://tauri.localhost,https://tauri.localhost
# Patrón para varias páginas/subdominios del proyecto sin listarlas todas:
CORS_ORIGIN_REGEX=https://.*\.l20j45\.us(:\d+)?

# --- Opcional: SMTP para el correo de bienvenida y recuperación ----------
# Sin SMTP la API funciona, pero los códigos de 6 dígitos van al log.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# --- Rate limiting (defaults del template; no tocar sin discutir) --------
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_REGISTER_PER_MIN=5
# RATE_LIMIT_FORGOT_PER_MIN=5
