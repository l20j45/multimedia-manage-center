# ============================================================
# .env.example — plantilla de variables globales compartidas
# Copia este archivo a .env (NO se sube a git) y edita los valores.
# ============================================================

# --- Proyecto -------------------------------------------------
PROJECT_NAME=Biblioteca de Recursos Multimedia
PROJECT_SLUG=biblioteca-recursos-multimedia
PROJECT_IDENTIFIER=com.biblioteca-recursos-multimedia.app

# --- Backend (API FastAPI) -------------------------------------
# Dirección donde queda el backend. El frontend la consume como
# VITE_API_URL en build-time (web, escritorio y APK Android).
VITE_API_URL=http://localhost:8000

# --- Firma de la APK Android (build release) --------------------
# Genera el keystore una sola vez (exporta el JDK de Android Studio):
# "$JAVA_HOME/bin/keytool" -genkeypair -v -keystore android.keystore \
#   -storepass TU_PASSWORD -keypass TU_PASSWORD \  (pueden ser iguales)
#   -alias biblioteca-recursos-multimedia-key -keyalg RSA -keysize 2048 -validity 10000 \
#   -dname "CN=NOMBRE_PROYECTO, OU=Mobile, O=NOMBRE_PROYECTO, C=MX"
TAURI_ANDROID_KEYSTORE_PATH=/ruta/absoluta/a/android.keystore
TAURI_ANDROID_KEYSTORE_PASSWORD=tu-password
TAURI_ANDROID_KEY_ALIAS=biblioteca-recursos-multimedia-key
TAURI_ANDROID_KEY_PASSWORD=tu-password

# --- Docker (deploy del backend) -------------------------------
API_PORT=4010

# Motor de contenedores: docker | podman (vacío = autodetección docker→podman)
CONTAINER_ENGINE=

# Plataforma objetivo del build (vacío = nativa; ej. linux/arm64 para RPi 64 bits)
TARGET_PLATFORM=
