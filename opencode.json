{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "graphify": {
        "type": "local",
        "command": [
          "uv",
          "tool",
          "run",
          "--from",
          "graphifyy",
          "python",
          "-m",
          "graphify.serve",
          "graphify-out/graph.json"
        ],
        "cwd": "."
      }
    }
  }
}
